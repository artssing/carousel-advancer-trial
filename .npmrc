# @certifine packages live in GitHub Packages, not the public npm registry.
#
# The token is a VARIABLE, not a value — npm expands ${NODE_AUTH_TOKEN} at read
# time, so this file carries no secret and is safe to commit. Set the real
# token in your shell:  export NODE_AUTH_TOKEN=ghp_...
# It needs write:packages to publish, read:packages to install.
# See docs/setup/domain-package-release.md
@certifine:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
